---
import ArticleBody from "../../../components/ArticleBody.astro";
import { site } from "../../../config/site";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import type { AuthoringArticle } from "../../../lib/authoring/article-files";
import {
  readAuthoringPreviewArticles,
  resolveAuthoringLeadImage,
} from "../../../lib/authoring/preview-articles";

export async function getStaticPaths() {
  const articles = await readAuthoringPreviewArticles();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: AuthoringArticle;
}

const { article } = Astro.props;
const leadImage = resolveAuthoringLeadImage(article);
---

<SiteLayout
  pageTitle={`${site.copy.pages.articlePreview.documentTitlePrefix}: ${article.title}`}
>
  <ArticleLayout
    leadImage={leadImage
      ? {
          ...leadImage,
          src: `/preview/article-images/${article.slug}`,
        }
      : null}
    title={article.title}
    subtitle={article.subtitle}
    publishedAt={article.publishedAt}
  >
    <ArticleBody slot="body" body={article.bodyMarkdown} />
  </ArticleLayout>
</SiteLayout>
