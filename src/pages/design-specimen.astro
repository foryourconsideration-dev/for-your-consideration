---
import ArticleBody from "../components/ArticleBody.astro";
import ArticleLayout from "../layouts/ArticleLayout.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const specimenMarkdown = `
Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph.[^1]

## Section heading

Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph.

Body paragraph. Body paragraph. Body paragraph. Body paragraph. Body paragraph.

> Quotation

### Subheading

- List item
- List item
- List item

Body text with a [text link](https://example.com).

[^1]: Footnote text.
`;
---

<SiteLayout pageTitle="Design specimen">
  <ArticleLayout
    title="Article title"
    subtitle="Article subtitle"
    publishedAt="2026-08-18T12:00:00Z"
  >
    <ArticleBody slot="body" body={specimenMarkdown} />
  </ArticleLayout>
</SiteLayout>
