---
import { formatPublicationDate } from "../lib/dates/format-publication-date";

interface Props {
  publishedAt: string;
  subtitle?: string | null;
  title: string;
}

const { publishedAt, subtitle, title } = Astro.props;
---

<main class="page-container article-page">
  <article class="reading-container article-layout">
    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-metadata">
        <time datetime={publishedAt}>{formatPublicationDate(publishedAt)}</time>
      </p>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
    </header>

    <div class="article-body">
      <slot name="body" />
    </div>
  </article>
</main>

<style>
  .article-page {
    padding-block: clamp(3rem, 8vw, 8rem);
  }

  .article-header h1 {
    max-width: 18ch;
    margin-block: 0 1rem;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .article-metadata {
    margin-block: 0 clamp(2.5rem, 6vw, 5rem);
    color: var(--color-muted);
    font-size: 0.95em;
  }

  .article-subtitle {
    margin-block: 0 2rem;
    font-size: 1.2em;
    line-height: 1.35;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(blockquote) {
    margin-block-start: 0;
  }

  .article-body :global(h2) {
    margin-block: 2.75rem 0.8rem;
    font-size: 1.5em;
    font-weight: 600;
    line-height: 1.15;
  }

  .article-body :global(h3) {
    margin-block: 2.25rem 0.6rem;
    font-size: 1.15em;
    font-weight: 650;
    line-height: 1.25;
  }

  .article-body :global(p),
  .article-body :global(ul) {
    margin-block-end: 1.35em;
  }

  .article-body :global(ul) {
    padding-inline-start: 1.25em;
  }

  .article-body :global(li + li) {
    margin-block-start: 0.45em;
  }

  .article-body :global(blockquote) {
    margin: 2.75rem 0;
    padding-inline-start: clamp(1.25rem, 4vw, 2.5rem);
    border-inline-start: 1px solid var(--color-ink);
    font-size: 1.05em;
    font-style: italic;
    line-height: 1.3;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(.caption) {
    margin-block-start: 3rem;
    padding-block-start: 0.75rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-size: 0.8em;
    line-height: 1.45;
  }

  .article-body :global(.footnote-reference),
  .article-body :global([data-footnote-ref]) {
    margin-inline-start: 0.08em;
    font-size: 0.7em;
    font-weight: 600;
    line-height: 0;
  }

  .article-body :global(.footnotes) {
    margin-block-start: 4rem;
    padding-block-start: 1.25rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.8em;
    line-height: 1.5;
  }

  .article-body :global(.footnotes h2) {
    margin-block: 0 1rem;
    font-size: 1.25em;
  }

  .article-body :global(.footnotes ol) {
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .article-body :global(.footnote-backlink),
  .article-body :global([data-footnote-backref]) {
    margin-inline-start: 0.2em;
  }
</style>
