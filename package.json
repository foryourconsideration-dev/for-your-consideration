{
  "name": "for-your-consideration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --local --lang typescript > src/types/database.ts && prettier src/types/database.ts --write",
    "test": "node --test test/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "npm run format:check && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.3",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@supabase/supabase-js": "2.112.3",
    "astro": "^7.2.3",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "2.115.0",
    "typescript": "^6.0.3"
  }
}
