{
  "name": "for-your-consideration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16 <25"
  },
  "scripts": {
    "article:publish": "node scripts/publish-article.mjs",
    "article:preview": "node scripts/preview-articles.mjs",
    "article:unpublish": "node scripts/unpublish-article.mjs",
    "article:validate": "node scripts/validate-articles.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "build:authoring-fixture": "node scripts/build-authoring-fixture.mjs",
    "build:local": "node scripts/build-with-local-supabase.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --local --lang typescript > src/types/database.ts && prettier src/types/database.ts --write",
    "test": "node --test test/*.test.ts",
    "test:authoring-preview": "node --test test/authoring-preview/*.test.ts",
    "test:build": "node --test test/build/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\" --fix",
    "validate": "npm run format:check && npm run lint && npm run check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@supabase/supabase-js": "2.112.3",
    "astro": "^7.2.3",
    "rehype-sanitize": "^6.0.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "2.115.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
